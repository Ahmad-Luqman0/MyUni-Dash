<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- net5.0 is what the IIS server runs; net10.0 is for running locally (dotnet run -f net10.0).
       The code keeps to what .NET 5 has, so both builds behave the same. -->
  <PropertyGroup>
    <TargetFrameworks>net5.0;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- .NET 5 is out of support; the server has it, so the warnings about that are switched off here. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NETSDK1138;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <!-- 5.2.x is the last Microsoft.Data.SqlClient line that still runs on .NET 5 -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
