{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER,PORT;Database=SAC400;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Encrypt=False;"
  },
  "Database": {
    "CommandTimeoutSeconds": 120,
    "RequireApprovedReceipts": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5183",
      "http://127.0.0.1:5183"
    ]
  }
}
